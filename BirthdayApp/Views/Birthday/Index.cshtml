@model IEnumerable<BirthdayApp.Models.Birthday>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Celebrations";
}

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
    }

    .table {
        color: #e2e8f0 !important;
    }

        .table thead {
            color: #94a3b8 !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        }

    .btn-wish {
        border: 1px solid #38bdf8;
        color: #38bdf8;
        background: transparent;
    }

        .btn-wish:hover {
            background: #38bdf8;
            color: #000;
        }
</style>

<div class="glass-panel mb-4">
    <h5 class="fw-bold text-white">Welcome back to Joy Stream 👋</h5>
    <p class="text-white-50 small">Manage your team's historical records and celebrations.</p>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="glass-panel border-start border-4 border-warning">
            <h6 class="fw-bold text-white mb-2">Daily Notifications</h6>
            @if (ViewBag.TodayBirthdays != null && ((List<BirthdayApp.Models.Birthday>)ViewBag.TodayBirthdays).Count > 0)
            {
                @foreach (var bday in (List<BirthdayApp.Models.Birthday>)ViewBag.TodayBirthdays)
                {
                    <div class="text-warning small mb-1"><i class="bi bi-bell-fill"></i> Today is @bday.Name's birthday!</div>
                }
            }
            else
            {
                <div class="text-white-50 small">No birthdays today.</div>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="glass-panel">
            <h5 class="fw-bold text-white mb-3">Add Birthday</h5>
            <form asp-action="Create" method="post">
                <input name="Name" class="form-control bg-dark text-white mb-2" placeholder="Full Name" required />
                <input type="date" name="DateOfBirth" class="form-control bg-dark text-white mb-3" required />
                <button type="submit" class="btn btn-primary w-100">Add Birthday</button>
            </form>
        </div>
    </div>

    <div class="col-md-9">
        <div class="glass-panel">
            <h4 class="fw-bold text-white mb-3">Celebrations History</h4>
            <table class="table">
                <thead><tr><th>Name</th><th>Date</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isToday = (item.DateOfBirth.Day == DateTime.Today.Day && item.DateOfBirth.Month == DateTime.Today.Month);
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td>
                                @* Only show Edit/Delete if user is Creator or Admin *@
                                @if (item.CreatedBy == User.Identity?.Name || Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-warning me-2 text-decoration-none">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-danger bg-transparent border-0 p-0 text-decoration-none ms-2" onclick="return confirm('Are you sure you want to delete this?')">Delete</button>
                                    </form>
                                }

                                @if (isToday)
                                {
                                    <button class="btn btn-sm btn-wish ms-2" onclick="openWishModal(@item.Id, '@item.Name')">Send Wish</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
    function openWishModal(id, name) {
        let message = prompt("Send a birthday wish to " + name + ":");
        if (message) {
            fetch('/Birthday/SendWish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `birthdayId=${id}&message=${encodeURIComponent(message)}`
            }).then(res => {
                if (res.ok) {
                    confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 } });
                    alert("Wish sent successfully!");
                } else {
                    alert("Error sending wish.");
                }
            });
        }
    }
</script>