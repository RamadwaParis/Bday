@model IEnumerable<BirthdayApp.Models.Birthday>
@using Microsoft.AspNetCore.Http
@{
    Layout = "_Layout";
}

<style>
    .joystream-workspace-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 2rem;
    }

    .registration-form-panel {
        grid-column: span 1;
    }

    .directory-main-panel {
        grid-column: span 2;
    }

    .notifications-sidebar-panel {
        grid-column: span 1;
    }

    .premium-table {
        color: #f1f5f9 !important;
    }

        .premium-table thead th {
            background: rgba(255, 255, 255, 0.04) !important;
            color: #94a3b8 !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        }

        .premium-table tbody td {
            padding: 1.25rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

    .welcome-notification-toast {
        animation: slideInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        border-left: 4px solid #38bdf8;
    }

    .form-input-premium {
        background: rgba(15, 23, 42, 0.5) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: #ffffff !important;
        border-radius: 12px;
        padding: 0.65rem 1rem;
    }

    @@keyframes slideInUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@media (max-width: 1200px) {
        .joystream-workspace-grid {
            grid-template-columns: 1fr !important;
        }

        .registration-form-panel, .directory-main-panel, .notifications-sidebar-panel {
            grid-column: span 1 !important;
        }
    }
</style>

<div class="glass-panel welcome-notification-toast p-4 mb-4 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
        <div class="fs-2">👋</div>
        <div>
            <h5 class="fw-bold m-0 text-white">Welcome back to Joy Stream</h5>
            <p class="text-white-50 m-0 small">Your enterprise birthday tracking workspace is synchronized and running smoothly.</p>
        </div>
    </div>
    <button class="btn-close btn-close-white small" onclick="this.parentElement.remove()"></button>
</div>

<div class="container-fluid p-0">
    <div class="joystream-workspace-grid">

        <div class="glass-panel registration-form-panel">
            <h5 class="fw-bold text-white mb-1"><i class="bi bi-gift-fill text-info"></i> Add Birthday</h5>
            <p class="text-white-50 small mb-4">Register a new milestone to track</p>

            <form method="post" action="/Birthday/Create">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-white-50">Full Name</label>
                    <input type="text" name="Name" class="form-control form-input-premium" placeholder="" required />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-white-50">Date of Birth</label>
                    <input type="date" name="DateOfBirth" class="form-control form-input-premium" required />
                </div>

                <button type="submit" class="btn btn-luxury-primary w-100 fw-bold py-2.5 shadow-sm">
                    <i class="bi bi-plus-lg"></i> Add Birthday
                </button>
            </form>
        </div>

        <div class="glass-panel directory-main-panel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold m-0 text-white">Tracking Directory</h4>
                    <p class="text-white-50 m-0 small">Secure database tracking logs</p>
                </div>

                <form method="get" action="/Birthday/Index" class="d-flex position-relative align-items-center">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-dark border-0 text-white rounded-3 px-3 py-2 small" placeholder="Search profiles..." style="width: 180px; background: rgba(15, 23, 42, 0.4) !important; border: 1px solid rgba(255,255,255,0.1) !important;">
                </form>
            </div>

            <div class="table-responsive">
                <table class="table premium-table align-middle m-0">
                    <thead>
                        <tr>
                            <th>Names</th>
                            <th>Date of Birth</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-white">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (item.Name != null && item.Name.Length > 0)
                                        {
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-dark small" style="width:32px; height:32px; background: linear-gradient(135deg, #38bdf8, #a78bfa) !important;">
                                                @item.Name.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        @item.Name
                                    </div>
                                </td>
                                <td class="text-white-50 fw-medium">
                                    @item.DateOfBirth.ToString("dd MMMM yyyy")
                                </td>
                                <td class="text-end">
                                    @{
                                        var currentSessionRole = Context.Session.GetString("UserRole");
                                        var isOwner = User.Identity != null && User.Identity.IsAuthenticated && item.CreatedBy == User.Identity.Name;
                                        var isAdmin = currentSessionRole == "Admin";
                                    }

                                    <div class="d-inline-flex gap-3">
                                        @if (isOwner)
                                        {
                                            <a href="/Birthday/Edit/@item.Id" class="text-info text-decoration-none small fw-semibold"><i class="bi bi-pencil-square"></i> Edit</a>
                                        }

                                        @if (isOwner || isAdmin)
                                        {
                                            <a href="/Birthday/Delete/@item.Id" class="text-danger text-decoration-none small fw-semibold"><i class="bi bi-trash3-fill"></i> Delete</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-column gap-4 notifications-sidebar-panel">

            <div class="glass-panel" style="border-left: 4px solid #f59e0b;">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-bell-fill text-warning"></i> Active Reminders</h5>
                <div class="d-flex flex-column gap-3">
                    @if (ViewBag.TodayBirthdays != null)
                    {
                        foreach (var bday in ViewBag.TodayBirthdays)
                        {
                            <div class="p-3 rounded-3 d-flex flex-column gap-1" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.25);">
                                <span class="small fw-bold text-danger-emphasis text-uppercase tracking-wider" style="font-size:0.65rem; color: #f87171 !important;">⚠️ URGENT REMINDER</span>
                                <span class="text-white small fw-medium">Today is <strong>@bday.Name</strong>'s birthday! Send congratulations.</span>
                            </div>
                        }
                        if (ViewBag.TodayBirthdays.Count == 0)
                        {
                            <div class="text-center py-3 text-white-50 small">
                                <i class="bi bi-check2-all text-success fs-4 d-block mb-1"></i> No upcoming reminders scheduled for today.
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="glass-panel d-flex justify-content-between align-items-center py-4">
                <div>
                    <span class="text-white-50 small fw-bold text-uppercase tracking-wider" style="font-size:0.7rem;">Monitored Records</span>
                    <h3 class="fw-bold text-white m-0 mt-1">@ViewBag.TotalBirthdays</h3>
                </div>
                <div class="fs-1 text-info opacity-50"><i class="bi bi-database-fill-check"></i></div>
            </div>

        </div>

    </div>
</div>

<script>
    function triggerConfetti() {
        if (typeof confetti === 'function') {
            confetti({
                particleCount: 140,
                spread: 75,
                origin: { y: 0.65 },
                colors: ['#38bdf8', '#c084fc', '#34d399', '#fbbf24']
            });
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        var todayCount = @(ViewBag.TodayBirthdays != null ? ViewBag.TodayBirthdays.Count : 0);
        if (todayCount > 0) {
            triggerConfetti();
        }
    });
</script>