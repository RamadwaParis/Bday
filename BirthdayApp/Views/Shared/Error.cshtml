@model ErrorViewModel
@{
    ViewData["Title"] = "System Error";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6">
        <div class="card glass-card p-5 shadow-lg text-center">
            <h1 class="text-danger fw-bold mb-3"><i class="bi bi-exclamation-triangle-fill"></i> Error</h1>
            <h4 class="text-white mb-4">An internal system error occurred while processing your request.</h4>

            @if (Model?.ShowRequestId ?? false)
            {
                <div class="alert alert-secondary bg-dark border-secondary text-white small p-3 mb-4">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="text-start mt-4">
                <h5 class="text-white">Development Note</h5>
                <p class="text-white-50 small">
                    If you are the administrator, check the <strong>ASPNETCORE_ENVIRONMENT</strong> variable.
                    Swapping to <em>Development</em> mode will provide detailed stack traces and debugging information.
                </p>
            </div>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light">Return to Safety</a>
            </div>
        </div>
    </div>
</div>