@{
    Layout = "_Layout";
}
<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-5">
        <div class="card glass-card p-4 shadow">
            <h3 class="fw-bold text-center text-gradient mb-3">Create SaaS Profile</h3>
            <form method="post" action="/Account/Register">
                <div class="text-danger small mb-2">@Html.ValidationSummary(true)</div>
                <div class="mb-3">
                    <label class="form-label text-white-50">Full Name</label>
                    <input type="text" name="fullName" class="form-control bg-dark border-secondary text-white" required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-white-50">Email Address</label>
                    <input type="email" name="email" class="form-control bg-dark border-secondary text-white" required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-white-50">Password</label>
                    <input type="password" name="password" class="form-control bg-dark border-secondary text-white" required />
                </div>
                <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">Register Request</button>
            </form>
            <div class="text-center mt-3 small">
                <span class="text-muted">Already registered?</span> <a href="/Account/Login" class="text-info">Sign In</a>
            </div>
        </div>
    </div>
</div>