@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-4">
        <div class="card glass-card p-4 shadow">
            <h3 class="fw-bold text-center text-gradient mb-3">Reset Gateway</h3>
            <p class="text-white-50 small text-center">Provide system email address below to acquire recovery link.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-info bg-dark text-white border-info small">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <input type="email" name="email" class="form-control bg-dark border-secondary text-white"
                           placeholder="name@domain.com" required />
                </div>
                <button type="submit" class="btn btn-outline-light w-100">Send Recovery Directives</button>
            </form>

            <div class="text-center mt-3 small">
                <a asp-action="Login" class="text-white-50">Return to Login</a>
            </div>
        </div>
    </div>
</div>