@{
    Layout = "_Layout";
    ViewData["Title"] = "Governance Console";
}

<style>
    .admin-grid-layout {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .full-width-log-row {
        grid-column: span 2;
    }

    .dashboard-card {
        background: rgba(30, 41, 59, 0.4) !important;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1.5rem;
        color: #e2e8f0;
    }

    .user-row {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        color: #cbd5e1;
    }

    .table {
        color: #cbd5e1 !important;
    }

        .table thead {
            background: rgba(30, 41, 59, 0.8) !important;
            color: #94a3b8 !important;
        }

    @@media (max-width: 992px) {
        .admin-grid-layout {
            grid-template-columns: 1fr;
        }

        .full-width-log-row {
            grid-column: span 1;
        }
    }
</style>

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0 text-white">Governance Console</h2>
            <p class="text-white-50 m-0 small">Manage incoming platform memberships and review activity records.</p>
        </div>
    </div>

    <div class="admin-grid-layout">
        <!-- Pending Applications -->
        <div class="dashboard-card">
            <h5 class="fw-bold text-danger mb-3"><i class="bi bi-person-fill-exclamation"></i> Pending Applications</h5>
            @if (ViewBag.PendingUsers != null && ViewBag.PendingUsers.Count == 0)
            {
                <div class="text-center py-4 text-white-50 small">No pending registrations.</div>
            }
            else if (ViewBag.PendingUsers != null)
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var user in ViewBag.PendingUsers)
                    {
                        <div class="user-row p-3 rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-white d-block">@user.FullName</span>
                                <span class="small text-white-50">@user.Email</span>
                            </div>
                            <a asp-action="ApproveUser" asp-route-id="@user.Id" class="btn btn-outline-info btn-sm">Grant Access</a>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Authorized Members -->
        <div class="dashboard-card">
            <h5 class="fw-bold text-success mb-3"><i class="bi bi-person-check-fill"></i> Authorized Members</h5>
            <div class="d-flex flex-column gap-2" style="max-height: 280px; overflow-y: auto;">
                @if (ViewBag.ApprovedUsers != null)
                {
                    @foreach (var user in ViewBag.ApprovedUsers)
                    {
                        <div class="user-row p-3 rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-white d-block">@user.FullName</span>
                                <span class="small text-white-50">@user.Email</span>
                            </div>
                            <a asp-action="RevokeUser" asp-route-id="@user.Id" class="btn btn-outline-danger btn-sm">Revoke</a>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- System Audit Log -->
        <div class="dashboard-card full-width-log-row">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-terminal-split"></i> Platform System Audit Log</h5>
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table align-middle m-0 small">
                    <thead class="text-white-50">
                        <tr><th>Timestamp</th><th>Identity Account</th><th>Execution Details</th></tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Logs != null)
                        {
                            @foreach (var log in ViewBag.Logs)
                            {
                                <tr>
                                    <td class="text-white-50">@log.Timestamp</td>
                                    <td class="fw-semibold text-white">@log.UserEmail</td>
                                    <td><span class="badge bg-dark border border-warning text-warning">@log.ActionDetail</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>