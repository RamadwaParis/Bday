@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card glass-card p-5 shadow-lg rounded-4">
            <h2 class="fw-bold text-gradient mb-4">@ViewData["Title"]</h2>

            <p class="text-white-50">
                At <strong>Joy Stream</strong>, we prioritize the security and integrity of your data. This policy outlines how we handle your information within our birthday tracking workspace.
            </p>

            <h5 class="text-white mt-4">Data Collection</h5>
            <p class="text-white-50">
                We collect only the essential information required to maintain your birthday tracking dashboard. This includes your name, email, and the birthday milestones you choose to monitor.
            </p>

            <h5 class="text-white mt-4">Data Security</h5>
            <p class="text-white-50">
                Your data is stored securely using industry-standard encryption. Access to your personal dashboard is protected by our ASP.NET Core Identity-based security pipeline, ensuring that only authorized users can view or modify records.
            </p>

            <h5 class="text-white mt-4">Policy Updates</h5>
            <p class="text-white-50">
                We reserve the right to update this policy as our platform grows. We encourage you to review this page periodically to stay informed about how we protect your information.
            </p>

            <div class="mt-5 border-top border-secondary pt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>